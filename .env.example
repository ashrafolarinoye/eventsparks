# ─────────────────────────────────────────────
# EventSparks — Environment Variables
# Copy this file to .env and fill in the values
#
# SECURITY: never put privileged keys (service-role) in VITE_
# variables — they are shipped to every browser. VITE_ = public.
# ─────────────────────────────────────────────

# --------------------------------------------------
# SUPABASE (required, PUBLIC — safe to expose)
# Get these from: https://supabase.com/dashboard → project → Settings → API
# Use the "anon" "public" key. Row Level Security protects the data.
# --------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --------------------------------------------------
# ADMIN ACCESS
# There are no admin credentials in env vars. Admins are Supabase Auth
# users granted the 'admin' role in public.user_roles. After signing
# up via Supabase Auth, promote the user in the SQL editor:
#
#   INSERT INTO public.user_roles (user_id, role)
#   VALUES ('<user-uuid-from-auth.users>', 'admin');
# --------------------------------------------------

# --------------------------------------------------
# SUPABASE EDGE FUNCTIONS — server-side secrets
# Set these in: https://supabase.com/dashboard → project → Edge Functions → Secrets
# (These are NOT prefixed with VITE_ — they run on the server only)
# SUPABASE_URL / SUPABASE_ANON_KEY are injected automatically by the
# Supabase edge runtime — you do NOT need to set them.
# --------------------------------------------------

# Lovable AI API key — used by the chat edge function.
# The bot is grounded in the live `events` table (public read, anon key),
# so answers reflect real EventSparks listings.
# Get from: https://lovable.dev/dashboard → API Keys
LOVABLE_API_KEY=your-lovable-api-key

# Optional: point the chat function at any OpenAI-compatible chat completions
# endpoint to swap providers without code changes. Defaults to the Lovable
# AI gateway with google/gemini-3-flash-preview.
# AI_GATEWAY_URL=https://ai.gateway.lovable.dev/v1/chat/completions
# AI_CHAT_MODEL=google/gemini-3-flash-preview

# --------------------------------------------------
# SITE URL — used by the og-meta edge function to build canonical event URLs
# Set this to your production domain
# --------------------------------------------------
SITE_URL=https://your-production-domain.com

# --------------------------------------------------
# VERCEL (api/og.ts) — set in the Vercel project dashboard, NOT in VITE_
# Only the anon key is needed (events are publicly readable via RLS).
# --------------------------------------------------
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# SITE_URL=https://your-production-domain.com
